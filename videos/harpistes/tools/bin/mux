#!/usr/bin/env node
// Pose le son sur la vidéo (vidéo copiée telle quelle, son en AAC), durée exacte de la vidéo.
//   node tools/bin/mux --video rendu/video.mp4 --son rendu/son/mix.wav --sortie livraison/x.mp4 [--debit-son 320k]
import { execFileSync } from 'node:child_process';
import path from 'node:path';

const arg = (n, d) => { const i = process.argv.indexOf('--' + n); return i > 0 ? process.argv[i + 1] : d; };
const video = path.resolve(arg('video', 'rendu/video.mp4'));
const son = path.resolve(arg('son', 'rendu/son/mix.wav'));
const sortie = path.resolve(arg('sortie', 'rendu/video-son.mp4'));
const debitSon = arg('debit-son', '320k');
execFileSync('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-y', '-i', video, '-i', son, '-map', '0:v:0', '-map', '1:a:0',
  '-c:v', 'copy', '-c:a', 'aac', '-b:a', debitSon, '-ar', '48000', '-ac', '2', '-t', '20', '-movflags', '+faststart', sortie], { stdio: 'inherit' });
console.log('écrit', sortie);
